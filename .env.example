PORT=3000
# Mercado Pago. O servidor aceita MERCADOPAGO_* ou MERCADO_PAGO_*. A chave secreta fica só aqui, nunca no site.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Segredo do webhook (Mercado Pago > Suas integrações > Webhooks). Opcional: valida a assinatura dos avisos.
MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público https do site: o Mercado Pago avisa os pagamentos em APP_URL/api/mercadopago/webhook
APP_URL=
# Senha do painel do restaurante (/admin), conferida no servidor. OBRIGATÓRIA quando o servidor fica aberto na rede
# (HOST=0.0.0.0): sem ela, ou com uma senha antiga publicada (dads123), o servidor se recusa a iniciar.
# Só em 127.0.0.1 (este computador) a senha antiga ainda vale, com aviso.
ADMIN_PASSWORD=
# Texto qualquer, longo e secreto. Com ele, quem entrou no painel continua logado depois que o servidor reinicia.
SESSION_SECRET=
# Endereço em que o servidor escuta. Padrão 127.0.0.1 (só este computador). Na hospedagem na internet use 0.0.0.0.
# HOST=127.0.0.1
# Pasta dos dados (cardápio, configurações, pedidos e fotos). Sem isto ficam ao lado do server.js, como sempre.
# Na hospedagem, aponte para o disco persistente (ex.: /data). Na primeira vez, o cardápio e as configurações
# que vêm com o programa são copiados para lá; depois nada é sobrescrito. Veja DEPLOY.md.
# DATA_DIR=/data
# 1 = o servidor se recusa a iniciar se a pasta de dados estiver no mesmo disco do programa (disco temporário do container).
# A imagem Docker já vem com 1.
# REQUIRE_VOLUME=1
